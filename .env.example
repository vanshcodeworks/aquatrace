# AquaTrace backend configuration (all optional — sensible defaults apply).
# Copy to .env and adjust as needed.

# SQLite database file
# AQUATRACE_DB=P:/ai-tourism-hackathon/backend/aquatrace.db

# Water tariff used for cost estimates
# AQUATRACE_COST_PER_KL=150
# AQUATRACE_CURRENCY=₹

# Tank
# AQUATRACE_TANK_CAPACITY=50000

# Detection thresholds
# AQUATRACE_MIN_EXCESS_LPH=8
